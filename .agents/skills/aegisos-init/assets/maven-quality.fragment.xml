<?xml version="1.0" encoding="UTF-8"?>
<!-- 合并参考：这是 POM 片段，不能覆盖根 pom.xml，也不能直接用 mvn -f 执行。
     插件版本在 2026-10-21 核实 Central 已发布；非最新版本或无漏洞声明。
     properties/build/profiles 分别合入现有同名节点。保留已有等价工具与有效版本。
     Jupiter 依赖仍须按模块补充；仅有 Surefire 不会自动引入测试依赖。
     Check 会校验现有 Java 格式；初始化允许少量骨架迁移，业务代码先限定范围。
     security 仅配置；入口先 package 再直接调用 aggregate，避免父模块先扫描。
     nvd-auth 仅在非空 NVD_API_KEY 存在时由脚本启用，不传空密钥。 -->
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <properties>
    <spotless.version>2.43.0</spotless.version>
    <google-java-format.version>1.24.0</google-java-format.version>
    <maven-surefire.version>3.5.2</maven-surefire.version>
    <spotbugs-maven.version>4.10.5.0</spotbugs-maven.version>
    <dependency-check.version>13.0.0</dependency-check.version>
  </properties>
  <build>
    <plugins>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <googleJavaFormat>
              <version>${google-java-format.version}</version>
              <style>GOOGLE</style>
            </googleJavaFormat>
          </java>
        </configuration>
        <executions>
          <execution>
            <id>java-format-check</id>
            <phase>validate</phase>
            <goals><goal>check</goal></goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${maven-surefire.version}</version>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>static-analysis</id>
      <build>
        <plugins>
          <plugin>
            <groupId>com.github.spotbugs</groupId>
            <artifactId>spotbugs-maven-plugin</artifactId>
            <version>${spotbugs-maven.version}</version>
            <configuration>
              <effort>Max</effort>
              <threshold>Medium</threshold>
              <failOnError>true</failOnError>
            </configuration>
            <executions>
              <execution>
                <id>static-analysis-check</id>
                <phase>verify</phase>
                <goals><goal>check</goal></goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>security</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.owasp</groupId>
            <artifactId>dependency-check-maven</artifactId>
            <version>${dependency-check.version}</version>
            <inherited>false</inherited>
            <configuration>
              <formats><format>HTML</format><format>JSON</format></formats>
              <failBuildOnCVSS>7</failBuildOnCVSS>
              <failOnError>true</failOnError>
              <connectionTimeout>10000</connectionTimeout>
              <readTimeout>60000</readTimeout>
              <nvdMaxRetryCount>2</nvdMaxRetryCount>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
        <id>nvd-auth</id>
        <build>
            <plugins>
                <plugin>
                    <groupId>org.owasp</groupId>
                    <artifactId>dependency-check-maven</artifactId>
                    <version>${dependency-check.version}</version>
                    <inherited>false</inherited>
                    <configuration>
                        <nvdApiKeyEnvironmentVariable>NVD_API_KEY</nvdApiKeyEnvironmentVariable>
                    </configuration>
                </plugin>
            </plugins>
        </build>
    </profile>
  </profiles>
</project>
