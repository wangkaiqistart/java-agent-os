<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.aegisos</groupId><artifactId>aegisos-parent</artifactId><version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>aegisos-boot</artifactId>
    <name>AegisOS Boot</name>
    <description>Runnable Spring Boot application for AegisOS</description>
    <dependencies>
        <!-- YAML 解析仅属于 boot，版本由批准的 Boot BOM 管理（2.6）。 -->
        <dependency><groupId>org.yaml</groupId><artifactId>snakeyaml</artifactId></dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>
        <dependency><groupId>io.aegisos</groupId><artifactId>aegisos-core</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>io.aegisos</groupId><artifactId>aegisos-provider</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>io.aegisos</groupId><artifactId>aegisos-memory</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>io.aegisos</groupId><artifactId>aegisos-tool</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>io.aegisos</groupId><artifactId>aegisos-channel-cli</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>io.aegisos</groupId><artifactId>aegisos-web</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>io.aegisos</groupId><artifactId>aegisos-storage</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>io.aegisos</groupId><artifactId>aegisos-cli</artifactId><version>${project.version}</version></dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.aegisos.boot.AegisOsApplication</mainClass>
                </configuration>
                <executions>
                    <execution><goals><goal>repackage</goal></goals></execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <!-- 默认不激活；模型凭据只继承环境，绝不转为 JVM 系统属性。 -->
        <profile>
            <id>real-provider-smoke</id>
            <build><plugins><plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-failsafe-plugin</artifactId><version>3.5.2</version>
                <configuration>
                    <!-- Boot repackage会替换主artifact为可执行JAR；Failsafe必须使用普通classes目录。 -->
                    <classesDirectory>${project.build.outputDirectory}</classesDirectory>
                    <includes><include>**/ProviderSmokeIT.java</include></includes>
                    <groups>real-provider</groups>
                    <failIfNoTests>true</failIfNoTests><failIfNoSpecifiedTests>true</failIfNoSpecifiedTests>
                    <systemPropertyVariables><aegisos.smoke.enabled>true</aegisos.smoke.enabled></systemPropertyVariables>
                </configuration>
                <executions><execution><goals><goal>integration-test</goal><goal>verify</goal></goals></execution></executions>
            </plugin></plugins></build>
        </profile>
        <!-- 独立真实ReAct验收；普通test/package/quality不启用。 -->
        <profile>
            <id>real-react-smoke</id>
            <build><plugins><plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-failsafe-plugin</artifactId><version>3.5.2</version>
                <configuration>
                    <classesDirectory>${project.build.outputDirectory}</classesDirectory>
                    <includes><include>**/ReactWeatherSmokeIT.java</include></includes>
                    <groups>real-react</groups>
                    <reportsDirectory>${project.build.directory}/react-smoke-failsafe-reports</reportsDirectory>
                    <failIfNoTests>true</failIfNoTests><failIfNoSpecifiedTests>true</failIfNoSpecifiedTests>
                    <systemPropertyVariables><aegisos.react-smoke.enabled>true</aegisos.react-smoke.enabled></systemPropertyVariables>
                </configuration>
                <executions><execution><goals><goal>integration-test</goal><goal>verify</goal></goals></execution></executions>
            </plugin></plugins></build>
        </profile>
    </profiles>
</project>
